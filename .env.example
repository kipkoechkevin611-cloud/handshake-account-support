# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Email Configuration
# CONTACT_EMAIL: Where client applications will be sent
CONTACT_EMAIL=smartassignmentsolver@gmail.com

# FROM_EMAIL: Must be a verified sender in Resend
# Option 1: Use Resend's free onboarding email: onboarding@resend.dev
# Option 2: Verify your own domain at https://resend.com/domains
FROM_EMAIL=onboarding@resend.dev
